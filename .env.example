# DB migration CLI用。コピー先: リポジトリルートの .env
# ローカルのCockroachDB（insecureモード）を想定。DB自体は事前に作成してください。
# API/Internal の .dev.vars にも同じDBのURLを設定してください。
DB_URL="postgresql://root@127.0.0.1:26257/recourt?sslmode=disable"

# CockroachDB CloudなどTLSが必要な接続先では、提供されたURLをそのまま使用してください。
# 例: postgresql://USER:PASSWORD@HOST:26257/recourt?sslmode=verify-full

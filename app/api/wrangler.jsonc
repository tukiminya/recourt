{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "recourt-api",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "main": "src/main.ts",
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "services": [{ "binding": "INTERNAL_SERVICE", "service": "recourt-internal" }],
  "routes": [{ "pattern": "api.recourt-v1.tuki.dev", "custom_domain": true }],
  "vars": {
    "WEB_ORIGIN": "https://recourt-v1.tuki.dev",
    "CASE_READING_MOCK": "false",
  },
  "browser": { "binding": "BROWSER", "remote": true },
  "secrets": { "required": ["VERCEL_AI_GATEWAY_API_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recourt-database",
      "database_id": "1f0fa95d-387f-449c-b5f2-9113f3a55034",
      "migrations_dir": "../../packages/database/d1-migrations",
      "migrations_pattern": "../../packages/database/d1-migrations/*/migration.sql",
    },
  ],
  "ratelimits": [
    { "name": "IMPORT_LIMIT", "namespace_id": "26092611", "simple": { "limit": 3, "period": 60 } },
    { "name": "CHAT_LIMIT", "namespace_id": "26092612", "simple": { "limit": 20, "period": 60 } },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "dev": {
    "port": 8787,
    "inspector_port": 9229,
  },
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "recourt-crawler",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": {
    // Cloudflare Cron Triggers use UTC. 18:00 UTC is 03:00 JST the following day.
    "crons": ["0 18 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "services": [
    { "binding": "EXTERNAL_SERVICE", "service": "recourt-external-service" },
  ],
  "queues": {
    "producers": [
      { "binding": "CRAWLER_QUEUE", "queue": "recourt-crawler" },
      { "binding": "EXTRACT_QUEUE", "queue": "recourt-extract" },
    ],
    "consumers": [
      {
        "queue": "recourt-crawler",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 30,
        "dead_letter_queue": "recourt-crawler-dlq",
      },
    ],
  },
  "workflows": [
    { "name": "crawl-search", "binding": "CRAWL_SEARCH", "class_name": "CrawlSearchWorkflow" },
    { "name": "crawl-case", "binding": "CRAWL_CASE", "class_name": "CrawlCaseWorkflow" },
  ],
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "recourt-frontend",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "recourt-v1.tuki.dev",
    },
  ],
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "recourt-extract",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/main.ts",
  "observability": {
    "enabled": true,
  },
  "workflows": [
    {
      "name": "store-article",
      "binding": "STORE_ARTICLE",
      "class_name": "StoreArticleWorkflow",
    },
  ],
}
